rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny all requests
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profile
    match /users/{userId} {
      allow read, write: if isOwner(userId) && isValidId(userId);
    }

    // Financial Profile & subcollections
    match /financial_profiles/{userId} {
      allow read, write: if isOwner(userId) && isValidId(userId);

      match /bills/{billId} {
        allow read, write: if isOwner(userId) && isValidId(billId);
      }

      match /expenses/{expenseId} {
        allow read, write: if isOwner(userId) && isValidId(expenseId);
      }
    }
  }
}
